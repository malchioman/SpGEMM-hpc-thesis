cmake_minimum_required(VERSION 3.21)

set(expected_validation PARTIAL_PASS)
set(expected_result_finite 1)
if(INPUT_CASE STREQUAL "rectangular")
    set(input_args --matrix-a "${DATA_DIR}/tiny_rectangular.mtx"
                   --matrix-b "${DATA_DIR}/tiny_symmetric.mtx")
    set(expected_c_nnz 4)
elseif(INPUT_CASE STREQUAL "empty")
    set(input_args --matrix "${DATA_DIR}/empty.mtx")
    set(expected_c_nnz 0)
elseif(INPUT_CASE STREQUAL "cancellation")
    set(input_args --matrix "${DATA_DIR}/cancellation.mtx")
    set(expected_c_nnz 2)
elseif(INPUT_CASE STREQUAL "overflow")
    set(input_args --matrix "${DATA_DIR}/overflow_product.mtx")
    set(expected_validation PARTIAL_FAIL)
    set(expected_result_finite 0)
    set(expected_c_nnz 2)
else()
    message(FATAL_ERROR "Unknown input case: ${INPUT_CASE}")
endif()

file(REMOVE "${RESULTS_FILE}")
execute_process(
    COMMAND "${MPIEXEC_EXECUTABLE}" "${MPIEXEC_NUMPROC_FLAG}" 2
            ${MPIEXEC_PREFLAGS} "${BENCHMARK}" ${MPIEXEC_POSTFLAGS}
            ${input_args} --partial --threads 1 --warmup 0 --repeats 1 --trials 1
            --results "${RESULTS_FILE}"
    RESULT_VARIABLE exit_code OUTPUT_VARIABLE output ERROR_VARIABLE error_output TIMEOUT 25)
if(expected_validation STREQUAL "PARTIAL_FAIL")
    if(NOT "${exit_code}" MATCHES "^[1-9][0-9]*$")
        message(FATAL_ERROR "Expected failure, got '${exit_code}'.\n${output}\n${error_output}")
    endif()
elseif(NOT "${exit_code}" STREQUAL "0")
    message(FATAL_ERROR "Expected success, got '${exit_code}'.\n${output}\n${error_output}")
endif()

string(REPLACE "\r\n" "\n" output "${output}")
foreach(line IN ITEMS "validation=${expected_validation}" "max_abs_error=NA")
    string(FIND "\n${output}" "\n${line}\n" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "Missing summary line '${line}'.\n${output}")
    endif()
endforeach()
file(STRINGS "${RESULTS_FILE}" lines)
list(LENGTH lines count)
if(NOT count EQUAL 2)
    message(FATAL_ERROR "Expected one TSV observation.")
endif()
list(GET lines 0 header)
list(GET lines 1 observation)
string(REPLACE "\t" ";" fields "${header}")
string(REPLACE "\t" ";" values "${observation}")
list(LENGTH fields field_count)
list(LENGTH values value_count)
if(NOT field_count EQUAL value_count)
    message(FATAL_ERROR "TSV row does not match header.")
endif()
set(expected_max_abs_error NA)
foreach(field IN ITEMS validation max_abs_error c_nnz result_finite)
    list(FIND fields "${field}" index)
    if(index EQUAL -1)
        message(FATAL_ERROR "Missing TSV column '${field}'.")
    endif()
    list(GET values ${index} value)
    if(NOT "${value}" STREQUAL "${expected_${field}}")
        message(FATAL_ERROR "TSV ${field}: expected '${expected_${field}}', got '${value}'.")
    endif()
endforeach()
